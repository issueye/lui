<?xml version="1.0" encoding="UTF-8"?>
<!-- 应用内导航（各页 include 本文件）：点按调用宿主 published 方法 PageClick，
     由按钮的 to 属性决定目标页（login / list / todo / script / m7 / ui / uidisp / uinav / uidlg）；
     当前页按钮由宿主加 active 类高亮 -->
<panel class="nav">
  <button id="nav-login" class="nav-btn" text="登录" to="login" onclick="PageClick"/>
  <button id="nav-list" class="nav-btn" text="列表" to="list" onclick="PageClick"/>
  <button id="nav-todo" class="nav-btn" text="待办" to="todo" onclick="PageClick"/>
  <button id="nav-script" class="nav-btn" text="脚本" to="script" onclick="PageClick"/>
  <button id="nav-m7" class="nav-btn" text="响应式" to="m7" onclick="PageClick"/>
  <button id="nav-ui" class="nav-btn" text="组件" to="ui" onclick="PageClick"/>
  <button id="nav-uidisp" class="nav-btn" text="展示" to="uidisp" onclick="PageClick"/>
  <button id="nav-uinav" class="nav-btn" text="导航" to="uinav" onclick="PageClick"/>
  <button id="nav-uidlg" class="nav-btn" text="浮层" to="uidlg" onclick="PageClick"/>
</panel>
