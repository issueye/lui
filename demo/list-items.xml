  </panel>
  <panel class="item">
    <panel class="avatar avatar-b"><label text="Bo"/></panel>
    <panel class="body">
      <label class="name" text="Bob"/>
      <label class="desc" text="短消息。"/>
    </panel>
  </panel>
  <panel class="item">
    <panel class="avatar avatar-c"><label text="Cy"/></panel>
    <panel class="body">
      <label class="name" text="Cindy"/>
      <label class="desc" text="这是一条较长的说明文本，用于验证中英混排在受限宽度下按字符与空格自动换行的效果。"/>
