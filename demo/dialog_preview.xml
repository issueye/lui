<?xml version="1.0" encoding="UTF-8"?>
<window title="弹窗预览" width="420" height="380">
  <script src="../ui/index.ts"/>
  <panel class="page" style="padding: 20px; display: flex; align-items: center; justify-content: center;">
    <panel class="ui-dialog__panel" style="width: 360px;">
      <panel class="ui-dialog__head">
        <label class="ui-dialog__title" text="系统配置修改"/>
        <panel class="ui-dialog__close">
          <ui-svg-icon name="close" size="12"/>
        </panel>
      </panel>
      <panel class="ui-dialog__divider"/>
      <panel class="ui-dialog__body">
        <label class="ui-text" text="确认修改核心配置文件？此操作将触发服务重载并更新集群节点。"/>
        <panel style="height: 12px;"/>
        <input placeholder="请输入管理员口令" value="admin_root_token"/>
      </panel>
      <panel class="ui-dialog__divider"/>
      <panel class="ui-dialog__foot">
        <button class="ui-btn" text="取消"/>
        <button class="ui-btn ui-btn--primary" text="确定提交"/>
      </panel>
    </panel>
  </panel>
</window>
