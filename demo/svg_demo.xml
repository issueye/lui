<window title="lui SVG 矢量图形与图标演示" width="800" height="600" style="padding: 24px; background-color: #f5f5f5;">
  <ui-card title="SVG 矢量图形与图标展示">
    <ui-row gutter="16" style="margin-bottom: 20px;">
      <!-- 卡片 1: 外部 SVG 图标与徽标 -->
      <ui-col span="8">
        <panel style="padding: 16px; border: 1px solid #e8e8e8; border-radius: 8px; background-color: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <svg src="demo/assets/lui-logo.svg" width="80" height="80" style="margin-bottom: 12px;"/>
          <label text="外部 SVG Logo" style="font-weight: bold; font-size: 14px; margin-bottom: 4px;"/>
          <label text="demo/assets/lui-logo.svg" style="color: #8c8c8c; font-size: 12px;"/>
        </panel>
      </ui-col>

      <!-- 卡片 2: 内联 SVG 图标与 currentColor -->
      <ui-col span="8">
        <panel style="padding: 16px; border: 1px solid #e8e8e8; border-radius: 8px; background-color: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <panel style="display: flex; flex-direction: row; gap: 16px; margin-bottom: 16px;">
            <!-- 心形图标 (红色) -->
            <svg width="32" height="32" viewBox="0 0 24 24" style="color: #ff4d4f;">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" fill="currentColor"/>
            </svg>
            <!-- 搜索放大镜 (蓝色) -->
            <svg width="32" height="32" viewBox="0 0 24 24" style="color: #1677ff;">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2.5"/>
              <line x1="16" y1="16" x2="21" y2="21" stroke="currentColor" stroke-width="2.5"/>
            </svg>
            <!-- 齿轮设置 (绿色) -->
            <svg width="32" height="32" viewBox="0 0 24 24" style="color: #52c41a;">
              <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="7" fill="none" stroke="currentColor" stroke-width="2" opacity="0.6"/>
              <path d="M12 2v2 M12 20v2 M2 12h2 M20 12h2" stroke="currentColor" stroke-width="2"/>
            </svg>
          </panel>
          <label text="内联矢量图元" style="font-weight: bold; font-size: 14px; margin-bottom: 4px;"/>
          <label text="动态继承 currentColor" style="color: #8c8c8c; font-size: 12px;"/>
        </panel>
      </ui-col>

      <!-- 卡片 3: 统计折线与几何多边形 -->
      <ui-col span="8">
        <panel style="padding: 16px; border: 1px solid #e8e8e8; border-radius: 8px; background-color: #ffffff; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <!-- 平滑贝塞尔波浪曲线 -->
          <svg width="120" height="40" viewBox="0 0 120 40" style="margin-bottom: 12px;">
            <path d="M 0 30 Q 30 5 60 25 T 120 15" fill="none" stroke="#722ed1" stroke-width="3"/>
            <circle cx="60" cy="25" r="4" fill="#722ed1"/>
            <circle cx="120" cy="15" r="4" fill="#52c41a"/>
          </svg>
          <label text="平滑贝塞尔波浪" style="font-weight: bold; font-size: 14px; margin-bottom: 4px;"/>
          <label text="Q/T 二次升阶平滑插值" style="color: #8c8c8c; font-size: 12px;"/>
        </panel>
      </ui-col>
    </ui-row>

    <!-- 底部按钮栏：带 SVG 图标的按钮 -->
    <panel style="display: flex; flex-direction: row; gap: 12px; justify-content: flex-end; align-items: center; margin-top: 16px;">
      <ui-button text="刷新数据" type="default" size="medium"/>
      <ui-button text="导出矢量报表" type="primary" size="medium"/>
    </panel>
  </ui-card>
</window>
